;entryDy=0;" edge="1" parent="1" source="S5" target="R1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeColor=#F47920;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=10;fontColor=#5A2050;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="R1" target="H2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n26" value="sin respuesta" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeColor=#F47920;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=10;fontColor=#5A2050;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="R1" target="E1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeColor=#F47920;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=10;fontColor=#5A2050;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="S6" target="H3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="notes" value="&lt;b&gt;Qué cambia en el modelo de datos&lt;/b&gt;&lt;br&gt;&lt;b&gt;Cambio del BP:&lt;/b&gt; &lt;b&gt;vacancies.hm_id&lt;/b&gt; captura la requisición; el BP solo llena &lt;b&gt;bp_validado_at / bp_validado_por / bp_comentarios&lt;/b&gt; y asigna &lt;b&gt;at_id&lt;/b&gt;. Pasar a Alineación exige validación del BP.&lt;br&gt;① Nueva tabla &lt;b&gt;interview_scores&lt;/b&gt; (interview_id, profile_id, competencia, puntaje 1–4, nota) y vista comparativa por candidato. Las competencias salen de &lt;b&gt;vacancies.competencias&lt;/b&gt;.&lt;br&gt;② Cambio en la política RLS de &lt;b&gt;interview_panel&lt;/b&gt;: cada entrevistador solo ve los veredictos y scores de otros cuando ya envió los suyos (o si es HM / AT / HRBP).&lt;br&gt;③ &lt;b&gt;pg_cron&lt;/b&gt; (o cron de Vercel) sobre &lt;b&gt;vacancy_overview&lt;/b&gt; e &lt;b&gt;interview_panel&lt;/b&gt; → inserta en &lt;b&gt;notifications&lt;/b&gt; y envía a Google Chat / correo; nueva regla de escalamiento al HRBP.&lt;br&gt;④ Nuevas tablas &lt;b&gt;candidate_access_tokens&lt;/b&gt; (enlace seguro sin login) y &lt;b&gt;candidate_messages&lt;/b&gt; (bitácora de correos por etapa) + plantillas de mensaje por etapa. Requiere aviso de privacidad (LFPDPPP)." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#FFFFFF;strokeColor=#ECE7EA;fontSize=11;fontColor=#241B22;" vertex="1" parent="1"><mxGeometry x="20" y="1030" width="1900" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>