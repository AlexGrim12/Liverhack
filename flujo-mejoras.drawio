<mxfile host="app.diagrams.net"><diagram id="flujo-mejoras" name="Flujo con mejoras"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1400" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Talento 360 — Flujo con mejoras propuestas" style="text;html=1;fontSize=22;fontStyle=1;fontColor=#5A2050;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="900" height="40" as="geometry"/></mxCell><mxCell id="subtitle" value="Flujo base (morado) + 4 mejoras (naranja, numeradas ①–④). Línea punteada = notificación / evento automático." style="text;html=1;fontSize=12;fontColor=#6B5F68;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="50" width="1200" height="24" as="geometry"/></mxCell><mxCell id="lg0" value="① Scorecards por competencia" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF3EB;strokeColor=#F47920;strokeWidth=2;fontColor=#241B22;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="95" width="280" height="44" as="geometry"/></mxCell><mxCell id="lg1" value="② Feedback independiente" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF3EB;strokeColor=#F47920;strokeWidth=2;fontColor=#241B22;fontSize=11;" vertex="1" parent="1"><mxGeometry x="320" y="95" width="280" height="44" as="geometry"/></mxCell><mxCell id="lg2" value="③ Recordatorios y escalamiento" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF3EB;strokeColor=#F47920;strokeWidth=2;fontColor=#241B22;fontSize=11;" vertex="1" parent="1"><mxGeometry x="620" y="95" width="280" height="44" as="geometry"/></mxCell><mxCell id="lg3" value="④ Estatus visible para el candidato" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF3EB;strokeColor=#F47920;strokeWidth=2;fontColor=#241B22;fontSize=11;" vertex="1" parent="1"><mxGeometry x="920" y="95" width="280" height="44" as="geometry"/></mxCell><mxCell id="lgb" value="Paso del flujo base" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#F6EEF4;strokeColor=#7B2D6E;fontColor=#241B22;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="150" width="200" height="34" as="geometry"/></mxCell><mxCell id="lgs" value="Acción automática del sistema" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#F7F5F6;strokeColor=#6B5F68;fontColor=#241B22;fontSize=11;" vertex="1" parent="1"><mxGeometry x="250" y="150" width="240" height="34" as="geometry"/></mxCell><mxCell id="lgd" value="Decisión" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F47920;strokeWidth=2;fontColor=#241B22;fontSize=11;" vertex="1" parent="1"><mxGeometry x="520" y="142" width="120" height="50" as="geometry"/></mxCell><mxCell id="lane0" value="HRBP" style="swimlane;html=1;horizontal=0;startSize=40;fillColor=#FFFFFF;swimlaneFillColor=#FAF8F9;strokeColor=#ECE7EA;fontStyle=1;fontColor=#5A2050;fontSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="200" width="2200" height="140" as="geometry"/></mxCell><mxCell id="lane1" value="Reclutamiento (AT)" style="swimlane;html=1;horizontal=0;startSize=40;fillColor=#FFFFFF;swimlaneFillColor=#FFFFFF;strokeColor=#ECE7EA;fontStyle=1;fontColor=#5A2050;fontSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="340" width="2200" height="140" as="geometry"/></mxCell><mxCell id="lane2" value="Hiring Manager / Panel" style="swimlane;html=1;horizontal=0;startSize=40;fillColor=#FFFFFF;swimlaneFillColor=#FAF8F9;strokeColor=#ECE7EA;fontStyle=1;fontColor=#5A2050;fontSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="480" width="2200" height="140" as="geometry"/></mxCell><mxCell id="lane3" value="Candidato" style="swimlane;html=1;horizontal=0;startSize=40;fillColor=#FFFFFF;swimlaneFillColor=#FFFFFF;strokeColor=#ECE7EA;fontStyle=1;fontColor=#5A2050;fontSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="620" width="2200" height="140" as="geometry"/></mxCell><mxCell id="lane4" value="Sistema (Supabase + cron + Gemini)" style="swimlane;html=1;horizontal=0;startSize=40;fillColor=#FFFFFF;swimlaneFillColor=#FAF8F9;strokeColor=#ECE7EA;fontStyle=1;fontColor=#5A2050;fontSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="760" width="2200" height="240" as="geometry"/></mxCell><mxCell id="A1" value="① Captura la requisición&lt;br&gt;(lo que necesita: requisitos,&lt;br&gt;no negociables, competencias&lt;br&gt;y banda salarial)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF3EB;strokeColor=#F47920;strokeWidth=2;fontColor=#241B22;fontSize=11;" vertex="1" parent="1"><mxGeometry x="150" y="506" width="160" height="88" as="geometry"/></mxCell><mxCell id="A2" value="BP valida lo que pide el HM&lt;br&gt;(viabilidad + banda salarial)&lt;br&gt;y asigna al reclutador (AT)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#F6EEF4;strokeColor=#7B2D6E;fontColor=#241B22;fontSize=11;" vertex="1" parent="1"><mxGeometry x="350" y="232" width="160" height="76" as="geometry"/></mxCell><mxCell id="E1" value="③ HRBP recibe escalamiento&lt;br&gt;y destraba con HM / AT" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF3EB;strokeColor=#F47920;strokeWidth=2;fontColor=#241B22;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1550" y="232" width="160" height="76" as="geometry"/></mxCell><mxCell id="Z1" value="Solicita oferta → Oferta&lt;br&gt;→ cierra vacante&lt;br&gt;(con motivo)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#F6EEF4;strokeColor=#7B2D6E;fontColor=#241B22;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1950" y="232" width="160" height="76" as="geometry"/></mxCell><mxCell id="B1" value="Alta de candidatos&lt;br&gt;+ carga de CV&lt;br&gt;(Búsqueda)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#F6EEF4;strokeColor=#7B2D6E;fontColor=#241B22;fontSize=11;" vertex="1" parent="1"><mxGeometry x="550" y="372" width="160" height="76" as="geometry"/></mxCell><mxCell id="B2" value="Envía pool al HM&lt;br&gt;(Atracción → Selección)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#F6EEF4;strokeColor=#7B2D6E;fontColor=#241B22;fontSize=11;" vertex="1" parent="1"><mxGeometry x="750" y="372" width="160" height="76" as="geometry"/></mxCell><mxCell id="B3" value="Agenda entrevista&lt;br&gt;(Calendar + Meet)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#F6EEF4;strokeColor=#7B2D6E;fontColor=#241B22;fontSize=11;" vertex="1" parent="1"><mxGeometry x="950" y="372" width="160" height="76" as="geometry"/></mxCell><mxCell id="A3" value="Alineación: AT y HM&lt;br&gt;afinan la búsqueda&lt;br&gt;(sistema notifica a AT, HM&lt;br&gt;y solicitante)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#F6EEF4;strokeColor=#7B2D6E;fontColor=#241B22;fontSize=11;" vertex="1" parent="1"><mxGeometry x="350" y="506" width="160" height="88" as="geometry"/></mxCell><mxCell id="nota_bp" value="El BP no edita el contenido: solo aprueba o devuelve con comentarios. Si el HM cambia algo ya validado, el sistema pide revalidar." style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#FFFFFF;strokeColor=#6B5F68;fontSize=10;fontColor=#6B5F68;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="550" y="236" width="360" height="68" as="geometry"/></mxCell><mxCell id="H1" value="Realiza la entrevista" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#F6EEF4;strokeColor=#7B2D6E;fontColor=#241B22;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1150" y="512" width="160" height="76" as="geometry"/></mxCell><mxCell id="H2" value="① Llena scorecard: califica&lt;br&gt;cada competencia + veredicto" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF3EB;strokeColor=#F47920;strokeWidth=2;fontColor=#241B22;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1350" y="512" width="160" height="76" as="geometry"/></mxCell><mxCell id="R1" value="③ Recibe recordatorio&lt;br&gt;(Google Chat / correo)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF3EB;strokeColor=#F47920;strokeWidth=2;fontColor=#241B22;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1550" y="512" width="160" height="76" as="geometry"/></mxCell><mxCell id="H3" value="Ve tabla comparativa y&lt;br&gt;decide: finalista o descarta&lt;br&gt;(con justificación)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#F6EEF4;strokeColor=#7B2D6E;fontColor=#241B22;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1750" y="512" width="160" height="76" as="geometry"/></mxCell><mxCell id="D3" value="¿Finalista?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F47920;strokeWidth=2;fontColor=#241B22;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1950" y="502" width="150" height="96" as="geometry"/></mxCell><mxCell id="C1" value="④ Recibe confirmación&lt;br&gt;y enlace de estatus&lt;br&gt;(sin login)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF3EB;strokeColor=#F47920;strokeWidth=2;fontColor=#241B22;fontSize=11;" vertex="1" parent="1"><mxGeometry x="550" y="652" width="160" height="76" as="geometry"/></mxCell><mxCell id="C2" value="④ Recibe invitación a la&lt;br&gt;entrevista y actualizaciones&lt;br&gt;de estatus por correo" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF3EB;strokeColor=#F47920;strokeWidth=2;fontColor=#241B22;fontSize=11;" vertex="1" parent="1"><mxGeometry x="950" y="652" width="160" height="76" as="geometry"/></mxCell><mxCell id="C3" value="④ Recibe resultado final&lt;br&gt;y cierre del proceso" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF3EB;strokeColor=#F47920;strokeWidth=2;fontColor=#241B22;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1950" y="652" width="160" height="76" as="geometry"/></mxCell><mxCell id="S2" value="④ Correo automático al&lt;br&gt;candidato en cada&lt;br&gt;cambio de etapa" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF3EB;strokeColor=#F47920;strokeWidth=2;fontColor=#241B22;fontSize=11;" vertex="1" parent="1"><mxGeometry x="750" y="782" width="160" height="76" as="geometry"/></mxCell><mxCell id="S3" value="Gemini genera la nota de Meet&lt;br&gt;→ entrevista 'completada'" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#F7F5F6;strokeColor=#6B5F68;fontColor=#241B22;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1150" y="782" width="160" height="76" as="geometry"/></mxCell><mxCell id="S4" value="② Feedback independiente:&lt;br&gt;ocultar el de los demás&lt;br&gt;hasta enviar el propio" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF3EB;strokeColor=#F47920;strokeWidth=2;fontColor=#241B22;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1350" y="782" width="160" height="76" as="geometry"/></mxCell><mxCell id="S5" value="③ Cron diario: al 80% del SLA&lt;br&gt;o feedback vencido → recordatorio;&lt;br&gt;si persiste, escala al HRBP" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF3EB;strokeColor=#F47920;strokeWidth=2;fontColor=#241B22;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1550" y="778" width="190" height="84" as="geometry"/></mxCell><mxCell id="S6" value="② Desbloquea feedback de&lt;br&gt;todos + tabla comparativa&lt;br&gt;de scorecards" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF3EB;strokeColor=#F47920;strokeWidth=2;fontColor=#241B22;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1750" y="782" width="160" height="76" as="geometry"/></mxCell><mxCell id="D2" value="¿Enviaron&lt;br&gt;todos?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F47920;strokeWidth=2;fontColor=#241B22;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1350" y="882" width="150" height="96" as="geometry"/></mxCell><mxCell id="n3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeColor=#7B2D6E;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=10;fontColor=#5A2050;exitX=1;e