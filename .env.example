# ---------- Supabase (Project Settings → API) ----------
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Clave PUBLICABLE (sb_publishable_...). NUNCA pongas aquí la secret/service_role: NEXT_PUBLIC_ se envía al navegador.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Modo demo: true = sin login, selector de 4 perfiles y datos en memoria (ignora Supabase). false/vacío = usa Supabase.
NEXT_PUBLIC_DEMO_MODE=false
# Link de Meet que muestra el modo demo al agendar (crea una reunión de antemano en meet.google.com y pega su link).
# Sin configurar se usa meet.google.com/new (reunión instantánea con la sesión de Google del navegador).
NEXT_PUBLIC_MEET_LINK=

# ---------- Solo servidor (sin prefijo NEXT_PUBLIC_) ----------
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Google Workspace (ver GOOGLE_SETUP.md) ----------
# Mismo OAuth client que configuraste en Supabase → Auth → Google. El servidor lo usa para renovar tokens.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Cifra los refresh tokens de Google en la base. Genera uno con:  openssl rand -base64 32
GOOGLE_TOKEN_ENC_KEY=
# Gemini (Google AI Studio → API keys) y modelo vigente (https://ai.google.dev/gemini-api/docs/models)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Webhook entrante del espacio de Google Chat donde llegan los recordatorios (opcional)
GOOGLE_CHAT_WEBHOOK_URL=
# Protege /api/cron/* (Vercel lo envía como "Authorization: Bearer <CRON_SECRET>")
CRON_SECRET=
