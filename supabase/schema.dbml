// Talento 360 — diagrama para https://dbdiagram.io  (Import → DBML, o pegar en el editor)
// Fuente de verdad: supabase/migrations/20260923000000_initial_schema.sql

Project talento360 {
  database_type: 'PostgreSQL'
  Note: 'Plataforma de reclutamiento — El Puerto de Liverpool'
}

// ---------------------------------------------------------------
// Enums
// ---------------------------------------------------------------
Enum app_role {
  hrbp
  at
  hm
  "user"
}

Enum vacancy_stage {
  requisicion
  alineacion
  busqueda
  atraccion
  seleccion
  oferta
  cerrada
}

Enum vacancy_level {
  bajo
  medio
  alto
  complejo
}

Enum vacancy_close_reason {
  contratado
  cancelada
  sin_candidatos
  presupuesto
}

Enum education_level {
  preparatoria
  licenciatura_trunca
  licenciatura
  posgrado
}

Enum language_level {
  basico
  intermedio
  avanzado
  nativo
}

Enum application_status {
  screening
  entrevista_agendada
  en_proceso
  finalista
  descartado
  contratado
}

Enum interview_type {
  screening
  tecnica
  cultural
  final
}

Enum interview_status {
  agendada
  completada
  cancelada
  no_show
}

Enum interviewer_verdict {
  recomendado
  con_reservas
  no_recomendado
}

Enum attribute_source {
  cv
  entrevista
  manual
}

Enum chat_role {
  "user"
  assistant
}

// ---------------------------------------------------------------
// Auth (Supabase) — solo la referencia
// ---------------------------------------------------------------
Table auth.users {
  id uuid [pk]
  email text
}

// ---------------------------------------------------------------
// Usuarios y catálogos
// ---------------------------------------------------------------
Table profiles {
  id uuid [pk, note: 'FK a auth.users']
  email text [not null, unique]
  nombre text [not null]
  avatar_url text
  role app_role [not null, default: 'user', note: 'Lo asigna un admin, el usuario no lo cambia']
  area text
  cargo text [note: 'Ej. Tech Lead, Product Lead']
  activo boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table holidays {
  fecha date [pk]
  nombre text [not null]
  Note: 'Dias inhabiles, se excluyen del SLA'
}

Table competencies {
  id uuid [pk, default: `gen_random_uuid()`]
  nombre text [not null, unique]
  activo boolean [not null, default: true]
}

Table vacancy_templates {
  id uuid [pk, default: `gen_random_uuid()`]
  categoria text [not null, unique, note: 'Ej. TI-Sistemas']
  area text [not null, note: 'Ej. TI y Sistemas']
  stack_opciones "text[]" [not null, default: `'{}'`]
  cert_ejemplo text
  exp_minima_default smallint [not null, default: 2]
  campos jsonb [not null, default: `'[]'`, note: 'Campos estructurados y filtrables por candidato']
  activo boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table sla_targets {
  nivel vacancy_level [not null]
  etapa vacancy_stage [not null]
  dias_habiles smallint [not null]

  indexes {
    (nivel, etapa) [pk]
  }
  Note: 'SLA objetivo en dias habiles por nivel y etapa'
}

Table stage_transitions {
  desde vacancy_stage [not null]
  hacia vacancy_stage [not null]
  roles "app_role[]" [not null, note: 'Roles que pueden ejecutar la transicion']

  indexes {
    (desde, hacia) [pk]
  }
  Note: 'Maquina de estados de la vacante'
}

// ---------------------------------------------------------------
// Vacantes
// ---------------------------------------------------------------
Table vacancies {
  id uuid [pk, default: `gen_random_uuid()`]
  folio bigint [not null, unique, increment, note: 'Mostrar como REQ-000123']
  titulo text [not null]
  area text [not null]
  template_id uuid [not null]
  nivel vacancy_level [not null, default: 'medio']
  etapa vacancy_stage [not null, default: 'requisicion']
  etapa_desde timestamptz [not null, default: `now()`]

  stack_requerido "text[]" [not null, default: `'{}'`]
  certificacion_deseable text
  exp_minima smallint [not null, default: 0]
  estudios_minimos education_level [not null, default: 'licenciatura']
  habilidades_clave text
  competencias "text[]" [not null, default: `'{}'`]
  requisitos jsonb [not null, default: `'{}'`]
  salario_min "numeric(12,2)"
  salario_max "numeric(12,2)"
  bp_validado_at timestamptz [note: 'El BP solo valida lo que pidio el HM']
  bp_validado_por uuid
  bp_comentarios text
  bp_devuelta_at timestamptz [note: 'El BP la devolvio con comentarios']
  enviada_at timestamptz [not null, default: `now()`, note: 'Ultima vez que el HM la envio o modifico']

  hm_id uuid [not null, note: 'Captura la requisicion']
  hrbp_id uuid [not null, note: 'BP que la valida']
  at_id uuid [note: 'Lo asigna el BP al validar']
  solicitante_id uuid [note: 'Rol user: seguimiento solo lectura']

  cierre_motivo vacancy_close_reason
  cerrada_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    hrbp_id
    at_id
    hm_id
    solicitante_id
    template_id
  }
}

Table vacancy_stage_history {
  id uuid [pk, default: `gen_random_uuid()`]
  vacancy_id uuid [not null]
  etapa vacancy_stage [not null]
  entered_at timestamptz [not null]
  exited_at timestamptz
  entered_by uuid
  dias_habiles_objetivo smallint
  dias_habiles_reales integer

  indexes {
    (vacancy_id, entered_at)
  }
}

// ---------------------------------------------------------------
// Candidatos y postulaciones
// ---------------------------------------------------------------
Table candidates {
  id uuid [pk, default: `gen_random_uuid()`]
  nombre text [not null]
  email text
  telefono text
  nivel_estudios education_level
  institucion text
  carrera text
  compensacion_actual "numeric(12,2)"
  compensacion_deseada "numeric(12,2)"
  moneda "char(3)" [not null, default: 'MXN']
  cv_path text [note: 'Bucket cvs: {candidate_id}/archivo']
  cv_texto text
  cv_procesado_at timestamptz
  fuente text
  aviso_privacidad_at timestamptz
  created_by uuid
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    created_by
  }
}

Table candidate_languages {
  candidate_id uuid [not null]
  idioma text [not null]
  nivel language_level [not null]

  indexes {
    (candidate_id, idioma) [pk]
  }
}

Table candidate_attributes {
  id uuid [pk, default: `gen_random_uuid()`]
  candidate_id uuid [not null]
  tag text [not null]
  fuente attribute_source [not null]
  contexto text
  interview_id uuid
  created_at timestamptz [not null, default: `now()`]

  indexes {
    interview_id
  }
  Note: 'Atributos detectados por IA (CV o entrevista) o manuales'
}

Table applications {
  id uuid [pk, default: `gen_random_uuid()`]
  vacancy_id uuid [not null]
  candidate_id uuid [not null]
  estatus application_status [not null, default: 'screening']
  compat_pct "numeric(5,2)"
  compat_fuente text [note: 'assessfirst, ia o manual']
  compat_detalle jsonb
  custom_fields jsonb [not null, default: `'{}'`, note: 'Valores de vacancy_templates.campos']
  decision_por uuid
  decision_at timestamptz
  decision_justificacion text
  created_by uuid
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (vacancy_id, candidate_id) [unique]
    (id, vacancy_id) [unique]
    (vacancy_id, estatus)
    candidate_id
  }
  Note: 'Una fila por candidato y vacante. Compatibilidad y estatus son por vacante'
}

// ---------------------------------------------------------------
// Entrevistas
// ---------------------------------------------------------------
Table interviews {
  id uuid [pk, default: `gen_random_uuid()`]
  application_id uuid [not null]
  vacancy_id uuid [not null, note: 'Denormalizado; garantizado por la FK compuesta']
  tipo interview_type [not null, default: 'tecnica']
  estado interview_status [not null, default: 'agendada']
  inicio timestamptz [not null]
  fin timestamptz [not null]
  calendar_event_id text [unique]
  meet_link text
  drive_doc_id text [unique]
  notas_path text [note: 'Bucket interview-notes']
  resumen_ia text
  resumen_puntos "text[]" [not null, default: `'{}'`]
  resumen_actualizado_at timestamptz
  agendada_por uuid
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    application_id
    (vacancy_id, inicio)
  }
}

Table interview_panel {
  interview_id uuid [not null]
  profile_id uuid [not null]
  veredicto interviewer_verdict
  notas text
  feedback_at timestamptz
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (interview_id, profile_id) [pk]
    profile_id
  }
  Note: 'Entrevistador y su feedback'
}

// ---------------------------------------------------------------
// Notificaciones y asistente de IA
// ---------------------------------------------------------------
Table notifications {
  id uuid [pk, default: `gen_random_uuid()`]
  recipient_id uuid [not null]
  tipo text [not null]
  titulo text [not null]
  detalle text
  vacancy_id uuid
  application_id uuid
  interview_id uuid
  urgente boolean [not null, default: false]
  due_at timestamptz
  leida_at timestamptz
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (recipient_id, created_at)
    vacancy_id
    application_id
    interview_id
  }
}

Table ai_conversations {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  vacancy_id uuid
  titulo text
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, created_at)
    vacancy_id
  }
}

Table ai_messages {
  id uuid [pk, default: `gen_random_uuid()`]
  conversation_id uuid [not null]
  role chat_role [not null]
  content text [not null]
  fuentes jsonb [note: 'Candidatos y entrevistas citados']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (conversation_id, created_at)
  }
}

Table google_credentials {
  user_id uuid [pk]
  refresh_token_enc text [not null, note: 'Cifrado AES-256-GCM; solo service_role']
  scopes text
  updated_at timestamptz [not null, default: `now()`]
}

Table candidate_messages {
  id uuid [pk, default: `gen_random_uuid()`]
  application_id uuid [not null]
  plantilla text [not null, note: 'recibida, avanza, entrevista o cierre']
  asunto text [not null]
  gmail_message_id text
  enviado_por uuid
  enviado_at timestamptz [not null, default: `now()`]
}

// ---------------------------------------------------------------
// Relaciones
// ---------------------------------------------------------------
Ref: profiles.id - auth.users.id [delete: cascade]

Ref: vacancies.template_id > vacancy_templates.id
Ref: vacancies.hrbp_id > profiles.id
Ref: vacancies.at_id > profiles.id
Ref: vacancies.hm_id > profiles.id
Ref: vacancies.solicitante_id > profiles.id
Ref: vacancies.bp_validado_por > profiles.id

Ref: vacancy_stage_history.vacancy_id > vacancies.id [delete: cascade]
Ref: vacancy_stage_history.entered_by > profiles.id

Ref: candidates.created_by > profiles.id
Ref: candidate_languages.candidate_id > candidates.id [delete: cascade]
Ref: candidate_attributes.candidate_id > candidates.id [delete: cascade]
Ref: candidate_attributes.interview_id > interviews.id [delete: set null]

Ref: applications.vacancy_id > vacancies.id [delete: cascade]
Ref: applications.candidate_id > candidates.id [delete: cascade]
Ref: applications.decision_por > profiles.id
Ref: applications.created_by > profiles.id

Ref: interviews.(application_id, vacancy_id) > applications.(id, vacancy_id) [delete: cascade]
Ref: interviews.agendada_por > profiles.id

Ref: interview_panel.interview_id > interviews.id [delete: cascade]
Ref: interview_panel.profile_id > profiles.id

Ref: google_credentials.user_id - profiles.id [delete: cascade]
Ref: candidate_messages.application_id > applications.id [delete: cascade]
Ref: candidate_messages.enviado_por > profiles.id
Ref: notifications.recipient_id > profiles.id [delete: cascade]
Ref: notifications.vacancy_id > vacancies.id [delete: cascade]
Ref: notifications.application_id > applications.id [delete: cascade]
Ref: notifications.interview_id > interviews.id [delete: cascade]

Ref: ai_conversations.user_id > profiles.id [delete: cascade]
Ref: ai_conversations.vacancy_id > vacancies.id [delete: cascade]
Ref: ai_messages.conversation_id > ai_conversations.id [delete: cascade]

// ---------------------------------------------------------------
// Grupos
// ---------------------------------------------------------------
TableGroup usuarios_y_catalogos {
  profiles
  holidays
  competencies
  vacancy_templates
  sla_targets
  stage_transitions
}

TableGroup vacantes {
  vacancies
  vacancy_stage_history
}

TableGroup candidatos {
  candidates
  candidate_languages
  candidate_attributes
  applications
}

TableGroup entrevistas {
  interviews
  interview_panel
}

TableGroup notificaciones_e_ia {
  notifications
  ai_conversations
  ai_messages
}
